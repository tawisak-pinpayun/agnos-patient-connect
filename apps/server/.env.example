PORT=4000

# MongoDB connection (ห้าม commit ค่าจริง)
MONGODB_URI=mongodb://<user>:<password>@<host>:27017/patient-connect?authSource=admin
MONGODB_DB=patient-connect

# origin ของหน้าเว็บที่อนุญาตให้ต่อ (คั่นด้วย comma)
CORS_ORIGINS=http://localhost:3000

# ระยะเวลาไม่มี activity ที่ถือว่าผู้ป่วยหยุดกรอก (ms)
IDLE_THRESHOLD_MS=30000

# จำนวนวันก่อนลบ draft ที่ไม่ถูก submit
DRAFT_TTL_DAYS=7
